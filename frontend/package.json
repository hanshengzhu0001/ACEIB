{
  "name": "aceib-frontend",
  "version": "1.0.0",
  "description": "Frontend for ACEIB Educational Platform",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@mdi/font": "^7.2.96",
    "axios": "^1.4.0",
    "pinia": "^2.1.0",
    "roboto-fontface": "*",
    "socket.io-client": "^4.7.2",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0",
    "vuetify": "^3.3.0",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/webfontloader": "^1.6.35",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.0",
    "prettier": "^3.0.0",
    "sass": "^1.69.5",
    "typescript": "~5.1.0",
    "vite": "^7.3.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue-tsc": "^3.1.8"
  }
}
